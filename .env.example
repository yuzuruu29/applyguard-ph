# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Without these the app runs fully local-only (free tier).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_PAYPAL_CLIENT_ID=YOUR-LIVE-PAYPAL-CLIENT-ID

# Supabase Edge Function secrets are configured with `supabase secrets set`.
# Never prefix server secrets with VITE_ and never commit their values:
# PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_ENVIRONMENT=production,
# PAYPAL_WEBHOOK_ID, ANTHROPIC_API_KEY, ANTHROPIC_MODEL, APP_ORIGIN.
