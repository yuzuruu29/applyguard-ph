{
  "name": "applyguard-product-story",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render:ad": "remotion render MarketingAd out/marketing-ad.mp4 --codec h264 --scale=1.2",
    "render:ad:vertical": "remotion render MarketingAdVertical out/marketing-ad-vertical.mp4 --codec h264",
    "render:ad:poster": "remotion still MarketingAd out/marketing-ad-poster.jpeg --frame 1865 --scale=1.2",
    "render:premium": "remotion render PremiumShowcaseDesktop out/premium-showcase-desktop.mp4 --codec h264",
    "render:premium:mobile": "remotion render PremiumShowcaseMobile out/premium-showcase-mobile.mp4 --codec h264",
    "render:premium:poster": "remotion still PremiumShowcaseDesktop out/premium-showcase-poster-desktop.jpeg --frame 120",
    "render:premium:poster:mobile": "remotion still PremiumShowcaseMobile out/premium-showcase-poster-mobile.jpeg --frame 120",
    "render:desktop": "remotion render ApplyGuardProductStoryDesktop out/desktop.mp4 --codec h264",
    "render:desktop:webm": "remotion render ApplyGuardProductStoryDesktop out/desktop.webm --codec vp8",
    "render:mobile": "remotion render ApplyGuardProductStoryMobile out/mobile.mp4 --codec h264",
    "render:mobile:webm": "remotion render ApplyGuardProductStoryMobile out/mobile.webm --codec vp8",
    "render:poster:desktop": "remotion still ApplyGuardProductStoryDesktop out/poster-desktop.png --frame 195",
    "render:poster:mobile": "remotion still ApplyGuardProductStoryMobile out/poster-mobile.png --frame 195",
    "render:all": "npm run render:desktop && npm run render:desktop:webm && npm run render:mobile && npm run render:mobile:webm && npm run render:poster:desktop && npm run render:poster:mobile",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/cli": "4.0.293",
    "@remotion/google-fonts": "^4.0.293",
    "@remotion/renderer": "4.0.293",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.293"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
